# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (liens d'invitation, callbacks OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facultatif : domaine des liens courts (ex. go.agence.fr, CNAME vers Vercel). Sinon <app>/l/<code>
NEXT_PUBLIC_SHORT_DOMAIN=

# Facultatif : emails transactionnels (signature, rendez-vous, onboarding) via Resend
RESEND_API_KEY=
EMAIL_FROM="Mon agence <bonjour@mon-agence.fr>"

# Facultatif : clé des HMAC de la signature électronique (codes, IP). Par défaut, la clé service role
SIGNATURE_SECRET=

# Meta Ads (developers.facebook.com > Mes apps > app de type Business, produit « Marketing API »)
META_APP_ID=
META_APP_SECRET=

# Google Ads (console.cloud.google.com : identifiants OAuth « Application Web »,
# + jeton développeur sur ads.google.com > Outils > Centre API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Facultatif : IA de la bibliothèque créa (tagging des pubs et concepts, recommandations).
# Clé sur console.anthropic.com. Coût indicatif : environ 1 € pour 1 000 éléments tagués
# (modèle rapide) et 5 à 10 centimes par recommandation (modèle avancé).
ANTHROPIC_API_KEY=
# Modèles surchargeables (par défaut claude-haiku-4-5-20251001 et claude-sonnet-5)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Plafond d'éléments tagués par synchro ou par clic (40 par défaut)
AI_TAG_LIMIT=

# Protège les routes cron (/api/cron/sync, /api/cron/creative-intel, /api/cron/booking-reminders)
CRON_SECRET=

# Facultatif : vérifie la signature du webhook Stripe du tracking (/api/t/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# Facultatif : clé de signature du paramètre state OAuth (par défaut, la clé service Supabase)
OAUTH_STATE_SECRET=
