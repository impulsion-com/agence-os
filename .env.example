# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (liens d'invitation, callbacks OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Ads (developers.facebook.com > Mes apps > app de type Business, produit « Marketing API »)
META_APP_ID=
META_APP_SECRET=

# Google Ads (console.cloud.google.com : identifiants OAuth « Application Web »,
# + jeton développeur sur ads.google.com > Outils > Centre API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Protège la route de synchronisation quotidienne (/api/cron/sync)
CRON_SECRET=

# Facultatif : clé de signature du paramètre state OAuth (par défaut, la clé service Supabase)
OAUTH_STATE_SECRET=
